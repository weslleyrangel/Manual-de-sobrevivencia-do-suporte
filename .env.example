# Configurações do Banco de Dados
DATABASE_URL=postgresql://postgres:password@db:5432/itsupport

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Mailtrap Email API (https://mailtrap.io)
# Substitua pelo seu API Token gerado no Mailtrap (Settings -> API Tokens)
MAILTRAP_TOKEN=
# Domínio de envio (use hello@demomailtrap.co para testes ou seu domínio verificado)
MAILTRAP_SENDER_EMAIL=hello@demomailtrap.co
MAILTRAP_SENDER_NAME="Manual de Sobrevivência do Suporte"
